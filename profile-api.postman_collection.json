{
  "info": {
    "name": "Mindbrain Profile API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for user profile CRUD operations. Use http://localhost:8000 as base URL."
  },
  "item": [
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"sudarshan rout\",\n  \"email\": \"sudarshanrout150@gmail.com\",\n  \"password\": \"password123\",\n  \"conformpassword\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/users",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["users"]
        }
      }
    },
    {
      "name": "Get User",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8000/users/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["users", ":id"]
        }
      }
    },
    {
      "name": "Update User",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"sudarshan rout updated\",\n  \"email\": \"sudarshanrout150@gmail.com\",\n  \"password\": \"newpassword123\",\n  \"conformpassword\": \"newpassword123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/users/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["users", ":id"]
        }
      }
    },
    {
      "name": "Delete User",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "http://localhost:8000/users/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["users", ":id"]
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sudarshanrout150@gmail.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["login"]
        }
      }
    }
  ]
}
